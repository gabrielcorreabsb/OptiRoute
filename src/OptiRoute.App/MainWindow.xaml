<Window x:Class="OptiRoute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OptiRoute.App.ViewModels"
        xmlns:p="clr-namespace:OptiRoute.App.Properties"
        mc:Ignorable="d"
        Title="{x:Static p:Strings.MainWindow_Title}"
        Height="700" Width="960"
        MinHeight="550" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Status Bar -->
            <RowDefinition Height="Auto"/> <!-- Gateways Bar -->
            <RowDefinition Height="*"/>    <!-- Applications List -->
            <RowDefinition Height="Auto"/> <!-- Footer / Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header / Status Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static p:Strings.MainWindow_BrandName}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Tokens.Accent.300}"/>
                    <Border Margin="12,0,0,0" Padding="8,3"
                            Background="{StaticResource Tokens.Accent.900}"
                            CornerRadius="{StaticResource Tokens.Radius.Small}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Static p:Strings.MainWindow_ArchitectureBadge}"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{StaticResource Tokens.Accent.300}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{x:Static p:Strings.MainWindow_OpnsenseLabel}"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                    <TextBlock Text="{Binding OpnsenseHost}"
                               Foreground="{StaticResource Tokens.Text.Secondary}"
                               FontSize="12" Margin="6,0,16,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static p:Strings.MainWindow_ThisComputerLabel}"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                    <TextBlock Text="{Binding LocalIp}"
                               Foreground="{StaticResource Tokens.Semantic.Success}"
                               FontSize="12" Margin="6,0,0,0" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Language Toggle (🌐) — switching requires app restart -->
                <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14"/>
                <ComboBox x:Name="LanguageSelector"
                          Style="{StaticResource Styles.ModernComboBox}"
                          Width="100"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableCultures}"
                          SelectedItem="{Binding SelectedCulture, Mode=TwoWay}"
                          ToolTip="Language / Idioma (restart required)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{x:Static p:Strings.MainWindow_RefreshButton}"
                        Command="{Binding SyncCommand}"
                        Style="{StaticResource Styles.SecondaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{x:Static p:Strings.MainWindow_RefreshButtonToolTip}"/>
                <Button Content="{x:Static p:Strings.MainWindow_ApplyRepairButton}"
                        Command="{Binding ApplyRepairCommand}"
                        IsEnabled="{Binding HasPendingRepair}"
                        Style="{StaticResource Styles.PrimaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{x:Static p:Strings.MainWindow_ApplyRepairButtonToolTip}"/>
                <Button Content="{x:Static p:Strings.MainWindow_AddApplicationButton}"
                        Command="{Binding AddApplicationCommand}"
                        Style="{StaticResource Styles.PrimaryButton}"
                        Margin="0,0,10,0"/>
                <Button Content="⚙"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="{x:Static p:Strings.MainWindow_SettingsButtonToolTip}"
                        Style="{StaticResource Styles.IconButton}"/>
            </StackPanel>
        </Grid>

        <!-- 2. Gateways Bar -->
        <Border Grid.Row="1"
                Style="{StaticResource Styles.Card}"
                Padding="12,8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{x:Static p:Strings.MainWindow_GatewaysLabel}"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ItemsControl ItemsSource="{Binding Gateways}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,0" Padding="8,3"
                                    Background="{StaticResource Tokens.Surface.Window}"
                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Tokens.Radius.Small}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Tokens.Semantic.Success}"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource Tokens.Text.Primary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 3. Applications List -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <!-- Estado Vazio -->
            <Border Style="{StaticResource Styles.Card}"
                    Padding="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasNoApplications, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🎮" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="{x:Static p:Strings.MainWindow_EmptyState_Title}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Tokens.Text.Inverse}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{x:Static p:Strings.MainWindow_EmptyState_Subtitle}"
                               Foreground="{StaticResource Tokens.Text.Dim}"
                               FontSize="13" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{x:Static p:Strings.MainWindow_EmptyState_AddButton}"
                            Command="{Binding AddApplicationCommand}"
                            Style="{StaticResource Styles.PrimaryButton}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Lista de Aplicativos -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasApplications, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Applications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Styles.Card}"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/> <!-- App Details & DSCP -->
                                        <ColumnDefinition Width="180"/> <!-- Global Default -->
                                        <ColumnDefinition Width="*"/>   <!-- This PC Routing -->
                                        <ColumnDefinition Width="180"/> <!-- Effective Status -->
                                        <ColumnDefinition Width="Auto"/> <!-- Delete -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Coluna 1: Nome do App e Status -->
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="Bold" FontSize="16"
                                                   Foreground="{StaticResource Tokens.Text.Inverse}"/>
                                        <TextBlock Text="{Binding Executable}"
                                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                                   FontSize="12" Margin="0,2,0,6"/>
                                        <WrapPanel>
                                            <Border Background="{StaticResource Tokens.Accent.900}"
                                                    CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                    Padding="6,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding Dscp, StringFormat='DSCP {0}'}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Tokens.Accent.300}"/>
                                            </Border>
                                            <!-- Badge de Status de Sincronização -->
                                            <Border Background="{StaticResource Tokens.Surface.Card}"
                                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                    Padding="6,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding SyncStateBadge}"
                                                           FontSize="11" FontWeight="Bold"
                                                           Foreground="{StaticResource Tokens.Text.Primary}"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Colunas Centrais: Painel Sincronizado vs Painel LocalOnly vs GlobalOnly -->
                                    <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0">
                                        <!-- Modo Sincronizado -->
                                        <Grid Visibility="{Binding IsSynchronized, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Global Default -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="{x:Static p:Strings.Card_GlobalDefaultLabel}"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <ComboBox Style="{StaticResource Styles.ModernComboBox}"
                                                          ItemsSource="{Binding AvailableGateways}"
                                                          SelectedItem="{Binding DefaultGateway}"
                                                          DisplayMemberPath="Name"/>
                                                <TextBlock Text="{x:Static p:Strings.Card_DefaultRoutingLabel}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <!-- Este Computador (Override) -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                <TextBlock Text="{x:Static p:Strings.Card_ThisComputerCardLabel}"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Content="{x:Static p:Strings.Card_FollowGlobalRadio}"
                                                                 IsChecked="{Binding UseGlobalDefault}"
                                                                 Foreground="{StaticResource Tokens.Text.Primary}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,14,0"/>
                                                    <RadioButton Content="{x:Static p:Strings.Card_LocalOverrideRadio}"
                                                                 IsChecked="{Binding UseLocalOverride}"
                                                                 Foreground="{StaticResource Tokens.Text.Primary}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                                    <ComboBox Style="{StaticResource Styles.ModernComboBox}"
                                                              ItemsSource="{Binding AvailableGateways}"
                                                              SelectedItem="{Binding SelectedOverrideGateway}"
                                                              IsEnabled="{Binding UseLocalOverride}"
                                                              DisplayMemberPath="Name"
                                                              Width="120"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Static p:Strings.Card_OverrideDescription}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Modo Somente Local (Órfão) — violeta -->
                                        <Border Background="#2E1065" BorderBrush="#581C87" BorderThickness="1"
                                                CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                                Padding="12,8"
                                                Visibility="{Binding IsLocalOnly, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Static p:Strings.Card_LocalOnly_Title}"
                                                               FontWeight="Bold" FontSize="12"
                                                               Foreground="#E9D5FF"/>
                                                    <TextBlock Text="{x:Static p:Strings.Card_LocalOnly_Subtitle}"
                                                               FontSize="11"
                                                               Foreground="#D8B4FE"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="{x:Static p:Strings.Card_LocalOnly_RegisterButton}"
                                                            Command="{Binding DataContext.PromoteLocalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Styles.PrimaryButton}"
                                                            Margin="0,0,8,0"/>
                                                    <Button Content="{x:Static p:Strings.Card_LocalOnly_RemoveButton}"
                                                            Command="{Binding DataContext.RemoveLocalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource Styles.DangerButton}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Modo Somente Global — neutro/azul-cinza -->
                                        <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1"
                                                CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                                Padding="12,8"
                                                Visibility="{Binding IsGlobalOnly, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static p:Strings.Card_GlobalOnly_Title}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="#94A3B8"/>
                                                <TextBlock Text="{x:Static p:Strings.Card_GlobalOnly_Subtitle}"
                                                           FontSize="11"
                                                           Foreground="#64748B"/>
                                                <TextBlock Text="{x:Static p:Strings.Card_GlobalOnly_Hint}"
                                                           FontSize="11"
                                                           Foreground="#94A3B8" Margin="0,4,0,0"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Modo Conflito — vermelho -->
                                        <Border Background="{StaticResource Tokens.Semantic.ErrorBg}"
                                                BorderBrush="#7F1D1D"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                                Padding="12,8"
                                                Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{x:Static p:Strings.Card_Conflict_Title}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="#FECACA"/>
                                                <TextBlock Text="{x:Static p:Strings.Card_Conflict_Subtitle}"
                                                           FontSize="11"
                                                           Foreground="#FCA5A5"/>
                                                <TextBlock Text="{x:Static p:Strings.Card_Conflict_Hint}"
                                                           FontSize="11"
                                                           Foreground="#FECACA" Margin="0,4,0,0"
                                                           FontStyle="Italic"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Coluna 4: Rota Efetiva e Motivo -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{x:Static p:Strings.Card_EffectiveRouteLabel}"
                                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"/>
                                        <Border Margin="0,4,0,2" Padding="10,4"
                                                Background="{StaticResource Tokens.Surface.Window}"
                                                BorderBrush="{StaticResource Tokens.Divider.Default}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource Tokens.Radius.Medium}">
                                            <TextBlock Text="{Binding EffectiveGateway}"
                                                       FontWeight="Bold" FontSize="13"
                                                       Foreground="{StaticResource Tokens.Accent.300}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Reason}" FontSize="10"
                                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Coluna 5: Ação Rápida de Exclusão -->
                                    <Button Grid.Column="4"
                                            Content="✕"
                                            Command="{Binding DataContext.DeleteApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource Styles.DangerButton}"
                                            VerticalAlignment="Center"
                                            ToolTip="{x:Static p:Strings.Card_DeleteButton_ToolTip}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 4. Footer / Status Bar -->
        <Border Grid.Row="3"
                Style="{StaticResource Styles.Card}"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                 Height="3"
                                 Foreground="{StaticResource Tokens.Accent.500}"
                                 Background="Transparent"
                                 BorderThickness="0" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource Tokens.Text.Secondary}"
                               FontSize="12"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{x:Static p:Strings.MainWindow_VersionFooter}"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>