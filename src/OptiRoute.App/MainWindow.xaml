<Window x:Class="OptiRoute.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:OptiRoute.App.ViewModels"
        xmlns:views="clr-namespace:OptiRoute.App.Views"
        xmlns:p="clr-namespace:OptiRoute.App.Properties"
        xmlns:loc="clr-namespace:OptiRoute.App.Markup"
        mc:Ignorable="d"
        Title="{loc:LString Key=MainWindow_Title}"
        Height="700" Width="1180"
        MinHeight="550" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}">

    <Grid Margin="20">
        <!-- Duas "páginas" mutuamente exclusivas (main content vs. settings panel).
             Ambas usam RowSpan=2: uma linha "*" não colapsa quando seu único filho
             está Collapsed, e apenas uma das duas fica visível por vez — assim cada
             uma ocupa toda a área disponível. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Main content: Header + Gateways + Apps + Footer ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header / Status Bar -->
                <RowDefinition Height="Auto"/> <!-- IP change banner (G16) -->
                <RowDefinition Height="Auto"/> <!-- Gateways Bar -->
                <RowDefinition Height="*"/>    <!-- Applications List -->
                <RowDefinition Height="Auto"/> <!-- Footer / Actions -->
            </Grid.RowDefinitions>

        <!-- 1. Header / Status Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:LString Key=MainWindow_BrandName}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Tokens.Accent.300}"/>
                    <Border Margin="12,0,0,0" Padding="8,3"
                            Background="{StaticResource Tokens.Surface.CardHover}"
                            BorderBrush="{StaticResource Tokens.Divider.Default}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Tokens.Radius.Small}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{loc:LString Key=MainWindow_ArchitectureBadge}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource Tokens.Text.Secondary}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="{loc:LString Key=MainWindow_OpnsenseLabel}"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                    <TextBlock Text="{Binding OpnsenseHost}"
                               Foreground="{StaticResource Tokens.Text.Secondary}"
                               FontSize="12" Margin="6,0,16,0" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:LString Key=MainWindow_ThisComputerLabel}"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                    <TextBlock Text="{Binding LocalIp}"
                               Foreground="{StaticResource Tokens.Semantic.Success}"
                               FontSize="12" Margin="6,0,0,0" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Language Toggle (🌐) — switching requires app restart -->
                <TextBlock Text="🌐" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="14"/>
                <ComboBox x:Name="LanguageSelector"
                          Style="{StaticResource Styles.ModernComboBox}"
                          Width="100"
                          Margin="0,0,10,0"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding AvailableCultures}"
                          SelectedItem="{Binding SelectedCulture, Mode=TwoWay}"
                          ToolTip="{loc:LString Key=MainWindow.ToolTip.LanguageSelector}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayName}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{loc:LString Key=MainWindow_RefreshButton}"
                        Command="{Binding SyncCommand}"
                        Style="{StaticResource Styles.SecondaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{loc:LString Key=MainWindow_RefreshButtonToolTip}"/>
                <Button Content="{loc:LString Key=MainWindow_ApplyRepairButton}"
                        Command="{Binding ApplyRepairCommand}"
                        IsEnabled="{Binding HasPendingRepair}"
                        Style="{StaticResource Styles.PrimaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{loc:LString Key=MainWindow_ApplyRepairButtonToolTip}"/>
                <Button Content="{loc:LString Key=MainWindow_AddApplicationButton}"
                        Command="{Binding AddApplicationCommand}"
                        Style="{StaticResource Styles.PrimaryButton}"
                        Margin="0,0,10,0"/>
                <Button Content="{loc:LString Key=MainWindow_Button_ExportDiagnostics}"
                        Command="{Binding ExportDiagnosticsCommand}"
                        Style="{StaticResource Styles.SecondaryButton}"
                        Margin="0,0,10,0"
                        ToolTip="{loc:LString Key=MainWindow_Button_ExportDiagnostics}"/>
                <Button Content="{loc:LString Key=MainWindow_OpenLogFolderButton}"
                        Command="{Binding OpenLogFolderCommand}"
                        ToolTip="{loc:LString Key=MainWindow_OpenLogFolderTooltip}"
                        Style="{StaticResource Styles.IconButton}"
                        Margin="0,0,10,0"/>
                <Button Content="ⓘ"
                        Command="{Binding ShowAboutCommand}"
                        ToolTip="{loc:LString Key=About_Title}"
                        Style="{StaticResource Styles.IconButton}"
                        Margin="0,0,10,0"/>
                <Button Content="&#xE713;"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Command="{Binding OpenSettingsCommand}"
                        ToolTip="{loc:LString Key=MainWindow_SettingsButtonToolTip}"
                        Style="{StaticResource Styles.IconButton}"/>
            </StackPanel>
        </Grid>

        <!-- 1b. IP change banner (G16) — aviso NÃO bloqueante de mudança de IP local -->
        <Border Grid.Row="1"
                Style="{StaticResource Styles.WarningBox}"
                Padding="12,8" Margin="0,0,0,16"
                Visibility="{Binding HasIpChangeBanner, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠" FontSize="14"
                           Foreground="{StaticResource Tokens.Semantic.Warning}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{loc:LString Key=Banner.IpChange.Title}"
                               FontWeight="Bold" FontSize="12"
                               Foreground="{StaticResource Tokens.Text.Inverse}"/>
                    <TextBlock Text="{Binding IpChangeBannerMessage}"
                               FontSize="11"
                               Foreground="{StaticResource Tokens.Text.Secondary}"
                               TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="✕"
                        Command="{Binding DismissIpChangeBannerCommand}"
                        Style="{StaticResource Styles.IconButton}"
                        VerticalAlignment="Center"
                        ToolTip="{loc:LString Key=Banner.DismissTooltip}"/>
            </Grid>
        </Border>

        <!-- 2. Gateways Bar -->
        <Border Grid.Row="2"
                Style="{StaticResource Styles.Card}"
                Padding="12,8" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:LString Key=MainWindow_GatewaysLabel}"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ItemsControl ItemsSource="{Binding Gateways}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,8,0" Padding="8,3"
                                    Background="{StaticResource Tokens.Surface.Window}"
                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Tokens.Radius.Small}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource Tokens.Semantic.Success}"
                                             Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold" FontSize="12"
                                               Foreground="{StaticResource Tokens.Text.Primary}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 3. Applications List -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <!-- Estado Vazio -->
            <Border Style="{StaticResource Styles.Card}"
                    Padding="32"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding HasNoApplications, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{loc:LString Key=MainWindow_EmptyState_Title}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Tokens.Text.Inverse}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:LString Key=MainWindow_EmptyState_Subtitle}"
                               Foreground="{StaticResource Tokens.Text.Dim}"
                               FontSize="13" Margin="0,6,0,16" HorizontalAlignment="Center"/>
                    <Button Content="{loc:LString Key=MainWindow_Button_AddFirstApp}"
                            Command="{Binding AddApplicationCommand}"
                            Style="{StaticResource Styles.PrimaryButton}"
                            HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Lista de Aplicativos -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Visibility="{Binding HasApplications, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Applications}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Styles.Card}"
                                    Padding="16"
                                    Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>   <!-- Header: app info + badges + delete -->
                                        <RowDefinition Height="Auto"/>   <!-- State banner for non-sync states -->
                                        <RowDefinition Height="Auto"/>   <!-- 3-route block -->
                                    </Grid.RowDefinitions>

                                    <!-- ══ Header ═══════════════════════════════════════════════════════ -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>       <!-- App name / executable -->
                                            <ColumnDefinition Width="Auto"/>    <!-- DSCP + SyncState badges -->
                                            <ColumnDefinition Width="Auto"/>    <!-- Delete -->
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontWeight="Bold" FontSize="16"
                                                       Foreground="{StaticResource Tokens.Text.Inverse}"/>
                                            <TextBlock Text="{Binding Executable}"
                                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                                       FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Border Background="{StaticResource Tokens.Surface.CardHover}"
                                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                    Padding="6,2" Margin="0,0,6,4">
                                                <TextBlock Text="{Binding Dscp, StringFormat='DSCP {0}'}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Tokens.Text.Secondary}"/>
                                            </Border>
                                            <!-- Badge de Status de Sincronização -->
                                            <Border Background="{StaticResource Tokens.Surface.Card}"
                                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                    Padding="6,2" Margin="0,0,6,4">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Fill" Value="{StaticResource Tokens.Text.Dim}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSynchronized}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLocalOnly}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Warning}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Error}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsGlobalOnly}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Info}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding SyncStateBadge}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{StaticResource Tokens.Text.Primary}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>

                                        <Button Grid.Column="2"
                                                Content="✕"
                                                Command="{Binding DataContext.DeleteApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource Styles.DangerButton}"
                                                VerticalAlignment="Center"
                                                ToolTip="{loc:LString Key=Card_DeleteButton_ToolTip}"/>
                                    </Grid>

                                    <!-- ══ State banner (non-synchronized) ═══════════════════════════════ -->
                                    <!-- LocalOnly -->
                                    <Border Grid.Row="1"
                                            Background="{StaticResource Tokens.Surface.CardHover}"
                                            BorderBrush="{StaticResource Tokens.Divider.Default}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                            Padding="12,8"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding IsLocalOnly, Converter={StaticResource BoolToVis}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:LString Key=Card_LocalOnly_Title}"
                                                           FontWeight="Bold" FontSize="12"
                                                           Foreground="{StaticResource Tokens.Text.Primary}"/>
                                                <TextBlock Text="{loc:LString Key=Card_LocalOnly_Subtitle}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource Tokens.Text.Secondary}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{loc:LString Key=Card_LocalOnly_RegisterButton}"
                                                        Command="{Binding DataContext.PromoteLocalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Styles.PrimaryButton}"
                                                        Margin="0,0,8,0"/>
                                                <Button Content="{loc:LString Key=Card_LocalOnly_RemoveButton}"
                                                        Command="{Binding DataContext.RemoveLocalCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource Styles.DangerButton}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- GlobalOnly -->
                                    <Border Grid.Row="1"
                                            Background="{StaticResource Tokens.Semantic.InfoBg}"
                                            BorderBrush="{StaticResource Tokens.Semantic.InfoBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                            Padding="12,8"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding IsGlobalOnly, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:LString Key=Card_GlobalOnly_Title}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Tokens.Text.Inverse}"/>
                                            <TextBlock Text="{loc:LString Key=Card_GlobalOnly_Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Tokens.Text.Secondary}"/>
                                            <TextBlock Text="{loc:LString Key=Card_GlobalOnly_Hint}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Tokens.Text.Dim}" Margin="0,4,0,0"
                                                       FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Conflict -->
                                    <Border Grid.Row="1"
                                            Background="{StaticResource Tokens.Semantic.ErrorBg}"
                                            BorderBrush="{StaticResource Tokens.Semantic.ErrorBorder}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                            Padding="12,8"
                                            Margin="0,12,0,0"
                                            Visibility="{Binding IsConflict, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{loc:LString Key=Card_Conflict_Title}"
                                                       FontWeight="Bold" FontSize="12"
                                                       Foreground="{StaticResource Tokens.Text.Inverse}"/>
                                            <TextBlock Text="{loc:LString Key=Card_Conflict_Subtitle}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Tokens.Text.Secondary}"/>
                                            <TextBlock Text="{loc:LString Key=Card_Conflict_Hint}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Tokens.Text.Dim}" Margin="0,4,0,0"
                                                       FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- ══ 3-Route block ═══════════════════════════════════════════════ -->
                                    <Border Grid.Row="2"
                                            Background="{StaticResource Tokens.Surface.Window}"
                                            BorderBrush="{StaticResource Tokens.Divider.Default}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Tokens.Radius.Medium}"
                                            Padding="12"
                                            Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>   <!-- Global Route -->
                                                <RowDefinition Height="Auto"/>   <!-- Separator -->
                                                <RowDefinition Height="Auto"/>   <!-- This PC -->
                                                <RowDefinition Height="Auto"/>   <!-- Separator -->
                                                <RowDefinition Height="Auto"/>   <!-- Effective Route -->
                                                <RowDefinition Height="Auto"/>   <!-- Verification -->
                                            </Grid.RowDefinitions>

                                            <!-- Global Route -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{loc:LString Key=Card_Route_GlobalLabel}"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Primary}"/>
                                                            <Setter Property="Text" Value="{Binding DefaultGateway, FallbackValue=''}"/>
                                                            <Setter Property="ToolTip" Value="{Binding DefaultGateway}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DefaultGateway}" Value="">
                                                                    <Setter Property="Text" Value="{loc:LString Key=Card_Route_EmptyValue}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Dim}"/>
                                                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Separator -->
                                            <Border Grid.Row="1"
                                                    Height="1"
                                                    Background="{StaticResource Tokens.Divider.Subtle}"
                                                    Margin="0,8"/>

                                            <!-- This PC -->
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{loc:LString Key=Card_Route_ThisPcLabel}"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>

                                                <!-- Current value -->
                                                <TextBlock Grid.Column="1"
                                                           VerticalAlignment="Center"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Primary}"/>
                                                            <Setter Property="Text" Value="{Binding SelectedOverrideGateway, FallbackValue=''}"/>
                                                            <Setter Property="ToolTip" Value="{Binding SelectedOverrideGateway}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UseGlobalDefault}" Value="True">
                                                                    <Setter Property="Text" Value="{loc:LString Key=Card_Route_UseGlobal}"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Dim}"/>
                                                                    <Setter Property="ToolTip" Value="{loc:LString Key=Card_Route_UseGlobal}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Edit controls (Synchronized only) -->
                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding IsSynchronized, Converter={StaticResource BoolToVis}}">
                                                    <RadioButton Content="{loc:LString Key=Card_FollowGlobalRadio}"
                                                                 IsChecked="{Binding UseGlobalDefault}"
                                                                 Foreground="{StaticResource Tokens.Text.Primary}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,12,0"/>
                                                    <RadioButton Content="{loc:LString Key=Card_LocalOverrideRadio}"
                                                                 IsChecked="{Binding UseLocalOverride}"
                                                                 Foreground="{StaticResource Tokens.Text.Primary}"
                                                                 VerticalAlignment="Center"
                                                                 Margin="0,0,8,0"/>
                                                    <ComboBox Style="{StaticResource Styles.ModernComboBox}"
                                                              ItemsSource="{Binding AvailableGateways}"
                                                              SelectedItem="{Binding SelectedOverrideGateway}"
                                                              IsEnabled="{Binding UseLocalOverride}"
                                                              MinWidth="140"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Separator -->
                                            <Border Grid.Row="3"
                                                    Height="1"
                                                    Background="{StaticResource Tokens.Divider.Subtle}"
                                                    Margin="0,8"/>

                                            <!-- Effective Route -->
                                            <Grid Grid.Row="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{loc:LString Key=Card_Route_EffectiveLabel}"
                                                           Foreground="{StaticResource Tokens.Text.Dim}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                                <Border Grid.Column="1"
                                                        Background="{StaticResource Tokens.Semantic.SuccessBg}"
                                                        BorderBrush="{StaticResource Tokens.Semantic.SuccessBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                        Padding="8,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding EffectiveGateway}"
                                                               FontWeight="Bold" FontSize="13"
                                                               Foreground="{StaticResource Tokens.Semantic.Success}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding EffectiveGateway}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Verification summary -->
                                            <Border Grid.Row="5"
                                                    Background="{StaticResource Tokens.Surface.CardHover}"
                                                    BorderBrush="{StaticResource Tokens.Divider.Default}"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource Tokens.Radius.Small}"
                                                    Padding="10,8"
                                                    Margin="0,10,0,0"
                                                    Visibility="{Binding IsVerified, Converter={StaticResource BoolToVis}}">
                                                <StackPanel>
                                                    <TextBlock FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding VerificationSummary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource Tokens.Semantic.Warning}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VerificationFailureReason}" Value="{x:Null}">
                                                                        <Setter Property="Foreground" Value="{StaticResource Tokens.Semantic.Success}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding VerificationFailureReason}" Value="">
                                                                        <Setter Property="Foreground" Value="{StaticResource Tokens.Semantic.Success}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding VerificationFailureReason}"
                                                               FontSize="11"
                                                               Foreground="{StaticResource Tokens.Semantic.Error}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,2,0,0"
                                                               Visibility="{Binding VerificationFailureReason, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 4. Footer / Status Bar (expandida — Phase 2 UX) -->
        <Border Grid.Row="4"
                Style="{StaticResource Styles.Card}"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Row 1: connection state + cancel -->
                    <RowDefinition Height="Auto"/> <!-- Row 2: status message + progress -->
                </Grid.RowDefinitions>

                <!-- ── Row 1: estado da conexão + botão cancelar ── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center"
                                ToolTip="{Binding ConnectionError}">
                        <!-- Dot de estado: vermelho (desconectado) / verde (conectado) / amarelo (carregando) -->
                        <Ellipse Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.85">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Error}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Success}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Fill" Value="{StaticResource Tokens.Semantic.Warning}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- Conectado -->
                        <TextBlock Text="{loc:LString Key=MainWindow.StatusBar.Connected}"
                                   Foreground="{StaticResource Tokens.Text.Secondary}"
                                   FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsConnected}" Value="True"/>
                                                <Condition Binding="{Binding IsLoading}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Conectando (carregando) -->
                        <TextBlock Text="{loc:LString Key=MainWindow.StatusBar.Connecting}"
                                   Foreground="{StaticResource Tokens.Semantic.Warning}"
                                   FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Desconectado -->
                        <TextBlock Text="{loc:LString Key=MainWindow.StatusBar.Disconnected}"
                                   Foreground="{StaticResource Tokens.Semantic.Error}"
                                   FontSize="12" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="{loc:LString Key=MainWindow.StatusBar.Cancel}"
                            Command="{Binding CancelSyncCommand}"
                            Style="{StaticResource Styles.Button.Small}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- ── Row 2: mensagem de status + progresso ── -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <!-- Idle: dim; ativo: primary -->
                                    <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Dim}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Tokens.Text.Primary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar Value="{Binding ProgressPercent}" Maximum="100"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     Height="3"
                                     Foreground="{StaticResource Tokens.Accent.500}"
                                     Background="Transparent"
                                     BorderThickness="0" Margin="0,6,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{loc:LString Key=MainWindow_VersionFooter}"
                               Foreground="{StaticResource Tokens.Text.Dim}"
                               VerticalAlignment="Bottom" FontSize="11" Margin="12,0,0,0"/>
                </Grid>
            </Grid>
        </Border>
        </Grid>

        <!-- ══ Settings panel (inline) ══ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              Visibility="{Binding IsSettingsPanelVisible, Converter={StaticResource BoolToVis}}">
            <!-- IsFirstRun é resolvido contra o DataContext (SettingsVm) — quando
                 true, o painel mostra o Welcome panel em vez das abas. -->
            <views:SettingsPanel DataContext="{Binding SettingsVm}"
                                 IsFirstRun="{Binding IsFirstRun}"
                                 Saved="OnSettingsPanelSaved"
                                 Cancelled="OnSettingsPanelCancelled"/>
        </Grid>
    </Grid>
</Window>