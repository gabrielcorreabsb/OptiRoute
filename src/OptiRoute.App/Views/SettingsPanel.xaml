<UserControl x:Class="OptiRoute.App.Views.SettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:p="clr-namespace:OptiRoute.App.Properties"
             xmlns:patterns="clr-namespace:OptiRoute.App.Themes.Patterns"
             xmlns:loc="clr-namespace:OptiRoute.App.Markup"
             mc:Ignorable="d"
             d:DesignHeight="540" d:DesignWidth="780">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             Welcome panel (visível somente quando IsFirstRun=true)
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Tokens.Accent.900}"
                BorderBrush="{StaticResource Tokens.Semantic.Info}"
                BorderThickness="2"
                CornerRadius="{StaticResource Tokens.Radius.XLarge}"
                Padding="40"
                Margin="0,0,0,16"
                Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="560"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="👋 FIRST TIME SETUP"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Semantic.Warning}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:LString Key=Wizard_Welcome_Title}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Text.Inverse}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{loc:LString Key=Wizard_Welcome_Subtitle}"
                           FontSize="14"
                           Foreground="{StaticResource Tokens.Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button Style="{StaticResource Styles.PrimaryButton}"
                        Content="{loc:LString Key=Wizard_NextButton}"
                        Click="OnWizardNextClick"
                        HorizontalAlignment="Center"
                        MinWidth="180" Padding="24,12"
                        FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             Tabbed settings (Connection / Credentials / Gateways / Advanced)
             ════════════════════════════════════════════════════════════════ -->
        <TabControl x:Name="SettingsTabs"
                    Grid.Row="0"
                    Style="{StaticResource Styles.TabControl}"
                    Visibility="{Binding IsNotFirstRun, Converter={StaticResource BoolToVis}}"
                    ItemContainerStyle="{StaticResource Styles.TabItem}">

            <!-- ─────────── Connection tab ─────────── -->
            <TabItem Header="{loc:LString Key=Settings_Tab_Connection}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- NOTA: os textos de ajuda do InstructionsExpander abaixo permanecem
                         literais em inglês — não há chaves em Strings.resx para eles, então
                         não podem ser convertidos para {loc:LString} sem criar recursos novos
                         (fora do escopo desta tarefa de live i18n). -->
                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How to find your OPNsense address">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="1. Open your OPNsense web interface in a browser."/><LineBreak/>
                                <Run Text="2. The address shown in the address bar is your OPNsense host (e.g. https://192.168.1.1)."/><LineBreak/>
                                <Run Text="3. Typical addresses: https://10.0.0.1, https://192.168.1.1, https://opnsense.local"/><LineBreak/>
                                <Run Text="4. Click 'Detect Again' to auto-fill your your IP."/><LineBreak/>
                                <Run Text="5. Connection auto-tests 500ms after you stop typing in Host/Key/ApiSecret."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <TextBlock Text="{loc:LString Key=Settings_Connection_OpnsenseAddress}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                 Text="{Binding OpnsenseHost, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- G14: versão do OPNsense (lida após conexão bem-sucedida).
                             Label + valor com fallback localizado quando ainda não há versão. -->
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="{loc:LString Key=Settings_Connection_OpnsenseVersionLabel}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding OpnsenseVersion}"
                                       Foreground="{StaticResource Tokens.Semantic.Success}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasOpnsenseVersion, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{loc:LString Key=Settings_Connection_OpnsenseVersionUnknown}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOpnsenseVersion}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{loc:LString Key=Settings_Connection_LocalComputer}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DetectedIp}"
                                   Foreground="{StaticResource Tokens.Semantic.Success}"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:LString Key=Settings_Connection_PreferredIp}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding PreferredLocalIp, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"/>
                            <Button Style="{StaticResource Styles.SecondaryButton}"
                                    Content="{loc:LString Key=Settings_Connection_DetectIpButton}"
                                    Command="{Binding DetectIpCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Grid.Row="3"
                              Style="{StaticResource Styles.ModernCheckBox}"
                              Content="{loc:LString Key=Settings_Connection_AllowInsecureTls}"
                              IsChecked="{Binding AllowInsecureTls}"
                              ToolTip="{loc:LString Key=Settings_Connection_AllowInsecureTlsTooltip}"
                              Margin="0,16,0,8"/>

                    <!-- Aviso persistente quando a validação TLS está desabilitada -->
                    <Border Grid.Row="4"
                            Style="{StaticResource Styles.WarningBox}"
                            Margin="0,0,0,8"
                            Visibility="{Binding AllowInsecureTls, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠"
                                       FontSize="14"
                                       Foreground="{StaticResource Tokens.Semantic.Warning}"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:LString Key=Settings_Connection_InsecureTlsWarning}"
                                       Foreground="{StaticResource Tokens.Text.Primary}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ─────────── Credentials tab ─────────── -->
            <TabItem Header="{loc:LString Key=Settings_Tab_Credentials}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How to obtain API credentials">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="1. In OPNsense, navigate to: System → Access → Users."/><LineBreak/>
                                <Run Text="2. Edit your API user (or create a dedicated one)."/><LineBreak/>
                                <Run Text="3. Click 'API keys' tab → '+ Generate new key'."/><LineBreak/>
                                <Run Text="4. Required permissions:"/><LineBreak/>
                                <Run Text="     •5 Firewall Aliases (read/write)"/><LineBreak/>
                                <Run Text="     •5 Firewall Rules (read/write)"/><LineBreak/>
                                <Run Text="     •5 Firewall Category (read/write)"/><LineBreak/>
                                <Run Text="5. Click 'Save' — copy both Key and Secret (shown only once)."/><LineBreak/>
                                <Run Text="6. Paste below, or use 'Import from file' to load the .txt file."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <TextBlock Text="{loc:LString Key=Settings_Credentials_ApiKey}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{loc:LString Key=Settings_Credentials_ApiSecret}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="SecretBox"
                                         Style="{StaticResource Styles.ModernPasswordBox}"
                                         Width="320"
                                         PasswordChanged="SecretBox_PasswordChanged"/>
                            <Button Style="{StaticResource Styles.SecondaryButton}"
                                    Content="{loc:LString Key=Settings_Credentials_RevealSecret}"
                                    Click="OnToggleSecretClick"
                                    Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Style="{StaticResource Styles.PrimaryButton}"
                                Content="{loc:LString Key=Settings_Credentials_ImportFile}"
                                Click="OnImportKeyFileClick"/>
                        <TextBlock Text="{Binding ImportStatus}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,16,0,0">
                        <Hyperlink NavigateUri="https://docs.opnsense.org/development/api.html"
                                   RequestNavigate="OnHowToCreateClick"
                                   Foreground="{StaticResource Tokens.Accent.300}">
                            <TextBlock Text="{loc:LString Key=Settings_Credentials_HowToCreate}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ─────────── Gateways tab ─────────── -->
            <TabItem Header="{loc:LString Key=Settings_Tab_Gateways}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How gateways are configured">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="• Gateway list is pulled from OPNsense (Routing → Gateways)."/><LineBreak/>
                                <Run Text="• Display Name is how OptiRoute refers to each gateway in the UI."/><LineBreak/>
                                <Run Text="• Names must be unique (case-insensitive)."/><LineBreak/>
                                <Run Text="• Click 'Reset' to revert to the original OPNsense name."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <DataGrid x:Name="GatewaysGrid"
                              Grid.Row="1"
                              Style="{StaticResource Styles.DataGrid}"
                              Margin="0,16,0,0"
                              ItemsSource="{Binding Gateways}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" RowHeight="40">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="{loc:LString Key=Settings_Gateways_ColumnDisplayName}"
                                                    Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="4,2"
                                                 FontStyle="Italic"
                                                 ToolTip="{loc:LString Key=Settings_Gateways_EditDisplayNameToolTip}"
                                                 VerticalAlignment="Center">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource Styles.ModernTextBox}">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Tokens.Divider.Default}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Tokens.Accent.500}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="{loc:LString Key=Settings_Gateways_ColumnOpnsenseName}"
                                                Binding="{Binding OpnsenseName}"
                                                IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="{loc:LString Key=Settings_Gateways_ColumnStatus}"
                                                Binding="{Binding Status}"
                                                IsReadOnly="True" Width="100"/>
                            <DataGridTemplateColumn Header="{loc:LString Key=Settings_Gateways_ColumnActions}"
                                                    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Styles.Button.Small}"
                                                Content="{loc:LString Key=Settings_Gateways_ResetButton}"
                                                Command="{Binding DataContext.ResetDisplayNameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding GatewaysStatus}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- ─────────── Advanced tab ─────────── -->
            <TabItem Header="{loc:LString Key=Settings_Tab_Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <patterns:InstructionsExpander
                                HeaderText="Advanced options — recommended defaults">
                            <patterns:InstructionsExpander.Slot>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource Tokens.Text.Secondary}">
                                    <Run Text="• DSCP pool: range of values to auto-assign when registering new apps."/><LineBreak/>
                                    <Run Text="    Avoid reserved values: 0 (default), 46 (EF), 48–63 (CS/experimental)."/><LineBreak/>
                                    <Run Text="• Log retention: days to keep %APPDATA%\OptiRoute\OptiRoute.log."/>
                                </TextBlock>
                            </patterns:InstructionsExpander.Slot>
                        </patterns:InstructionsExpander>

                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{loc:LString Key=Settings_Advanced_StartWithWindows}"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,16,0,8"/>
                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{loc:LString Key=Settings_Advanced_MinimizeToTray}"
                                  IsChecked="{Binding MinimizeToTray}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{loc:LString Key=Settings_Advanced_ShowTechnical}"
                                  IsChecked="{Binding ShowTechnical}"
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{loc:LString Key=Settings_Advanced_LogRetention}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"/>
                        </StackPanel>

                        <CheckBox x:Name="DscpPoolToggle"
                                  Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{loc:LString Key=Settings_Advanced_DscpPoolToggle}"
                                  IsChecked="{Binding EnableAdvancedDscp}"
                                  Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    IsEnabled="{Binding ElementName=DscpPoolToggle, Path=IsChecked}">
                            <TextBlock Text="{loc:LString Key=Settings_Advanced_DscpPoolStart}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding DscpPoolStart, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"/>
                            <TextBlock Text="{loc:LString Key=Settings_Advanced_DscpPoolEnd}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding DscpPoolEnd, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"/>
                        </StackPanel>

                        <!-- G15: reset destrutivo — apaga config + credenciais e reinicia o app. -->
                        <Border Style="{StaticResource Styles.ErrorBox}"
                                Margin="0,20,0,0">
                            <StackPanel>
                                <TextBlock Text="{loc:LString Key=Settings_Advanced_ResetToDefaultsDescription}"
                                           Foreground="{StaticResource Tokens.Text.Secondary}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8"/>
                                <Button Content="{loc:LString Key=Settings_Advanced_ResetToDefaultsButton}"
                                        Style="{StaticResource Styles.DangerButton}"
                                        Command="{Binding ResetDefaultsCommand}"
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer: status indicator (left) + action buttons (right) -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Auto-test status indicator (cross-tab visibility) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TestStatusIcon}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{Binding TestStatusBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TestStatusDisplay}"
                           Foreground="{Binding TestStatusBrush}"
                           FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           ToolTip="{Binding TestStatusTooltip}"/>
                <!-- Ação inline quando a falha é TLS e a validação ainda está ligada:
                     habilita AllowInsecureTls e re-testa a conexão. -->
                <Button Content="{loc:LString Key=Settings_Connection_AllowSelfSignedButton}"
                        Command="{Binding AllowSelfSignedCommand}"
                        Style="{StaticResource Styles.Button.Small}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding ShowAllowSelfSignedButton, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding LastTestErrorDetail}"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           FontSize="11"
                           Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding HasTestErrorDetail, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Style="{StaticResource Styles.SecondaryButton}"
                        Content="{loc:LString Key=Common_Cancel}"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button Style="{StaticResource Styles.PrimaryButton}"
                        Content="{loc:LString Key=Common_Save}"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsNotFirstRun, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>