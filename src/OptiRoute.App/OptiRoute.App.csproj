<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OptiRoute.Core\OptiRoute.Core.csproj" />
    <ProjectReference Include="..\OptiRoute.Windows\OptiRoute.Windows.csproj" />
    <ProjectReference Include="..\OptiRoute.OPNsense\OptiRoute.OPNsense.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Declares win-x64 as a known RID so dotnet restore on Linux (cross-build)
         populates project.assets.json with the net10.0-windows/win-x64 target.
         Without this, publish with no-build fails with NETSDK1047 because the
         assets file lacks the per-RID target. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Produce OptiRoute.exe instead of deriving the name from the
         OptiRoute.App project/assembly. -->
    <AssemblyName>OptiRoute</AssemblyName>
    <AssemblyTitle>OptiRoute</AssemblyTitle>
    <Product>OptiRoute</Product>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- WinForms apenas para o NotifyIcon do tray opcional (Phase 3). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.12" />
  </ItemGroup>

  <!-- Remove os global usings que o SDK do WinForms injeta automaticamente.
       Sem isso, System.Windows.Forms/System.Drawing tornam ambíguos tipos WPF
       já usados no app (Application, MessageBox, UserControl, Brush, Color).
       TrayIcon.cs referencia WinForms explicitamente via alias. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
