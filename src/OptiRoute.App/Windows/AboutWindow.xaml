<Window x:Class="OptiRoute.App.Windows.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:OptiRoute.App.Markup"
        mc:Ignorable="d"
        Title="{loc:LString Key=About_Title}"
        Height="480" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="🎮" FontSize="52" HorizontalAlignment="Center"/>
            <TextBlock Text="OptiRoute"
                       FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource Tokens.Accent.300}"
                       Margin="0,6,0,0"/>
            <TextBlock x:Name="VersionText"
                       FontSize="13" HorizontalAlignment="Center"
                       Foreground="{StaticResource Tokens.Text.Dim}"
                       Margin="0,4,0,0"/>
            <TextBlock Text="{loc:LString Key=About_Description}"
                       FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{StaticResource Tokens.Text.Secondary}"
                       HorizontalAlignment="Center" MaxWidth="360"
                       Margin="0,14,0,0"/>

            <Border Height="1" Background="{StaticResource Tokens.Divider.Default}"
                    Margin="0,20,0,16"/>

            <TextBlock Margin="0,0,0,8">
                <Hyperlink NavigateUri="https://github.com/gabrielcorreabsb/OptiRoute/blob/main/LICENSE"
                           RequestNavigate="OnLinkClick"
                           Foreground="{StaticResource Tokens.Accent.300}">
                    <Run Text="{loc:LString Key=About_License}"/>
                </Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,0,0,8">
                <Run Text="{loc:LString Key=About_Repository}" Foreground="{StaticResource Tokens.Text.Dim}"/>
                <Run Text="  "/>
                <Hyperlink NavigateUri="https://github.com/gabrielcorreabsb/OptiRoute"
                           RequestNavigate="OnLinkClick"
                           Foreground="{StaticResource Tokens.Accent.300}">
                    <Run Text="github.com/gabrielcorreabsb/OptiRoute"/>
                </Hyperlink>
            </TextBlock>

            <TextBlock Margin="0,0,0,8">
                <Run Text="{loc:LString Key=About_Issues}" Foreground="{StaticResource Tokens.Text.Dim}"/>
                <Run Text="  "/>
                <Hyperlink NavigateUri="https://github.com/gabrielcorreabsb/OptiRoute/issues"
                           RequestNavigate="OnLinkClick"
                           Foreground="{StaticResource Tokens.Accent.300}">
                    <Run Text="github.com/gabrielcorreabsb/OptiRoute/issues"/>
                </Hyperlink>
            </TextBlock>

            <Border Height="1" Background="{StaticResource Tokens.Divider.Default}"
                    Margin="0,16,0,16"/>

            <TextBlock x:Name="CopyrightText"
                       FontSize="12" HorizontalAlignment="Center"
                       Foreground="{StaticResource Tokens.Text.Dim}"/>
        </StackPanel>

        <Button Grid.Row="1"
                Content="{loc:LString Key=About_OkButton}"
                Click="OnOkClick"
                Style="{StaticResource Styles.PrimaryButton}"
                HorizontalAlignment="Right" MinWidth="110"/>
    </Grid>
</Window>
