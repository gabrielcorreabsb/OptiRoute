<Window x:Class="OptiRoute.App.Windows.InvalidTosDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:OptiRoute.App.Properties"
        Title="{x:Static p:Strings.Dialog_InvalidTos_Title}"
        Height="320" Width="560"
        MinHeight="280" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="#18181B"
        Foreground="#F4F4F5"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="⚠ Regra OptiRoute corrompida no OPNsense"
                       FontSize="16" FontWeight="Bold" Foreground="#F87171"/>
            <TextBlock x:Name="RuleDescriptionText"
                       Text="" FontSize="11" Foreground="#A1A1AA" Margin="0,6,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,16,0,16" Padding="14"
                Background="#27272A" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static p:Strings.Dialog_InvalidTos_DescriptionLabel}" Foreground="#A1A1AA" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DescriptionDscpText" FontWeight="Bold" Foreground="#93C5FD" FontFamily="Consolas"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static p:Strings.Dialog_InvalidTos_ActualTosLabel}" Foreground="#A1A1AA" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="ActualTosText" FontWeight="Bold" Foreground="#FCA5A5" FontFamily="Consolas"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="{x:Static p:Strings.Dialog_InvalidTos_CancelButton}"
                    Click="OnCancelClick"
                    Padding="14,8" Margin="0,0,8,0"
                    Background="#3F3F46" Foreground="#F4F4F5"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Grid.Column="2" Content="{x:Static p:Strings.Dialog_InvalidTos_ForceWindowsButton}"
                    Click="OnForceWindowsClick"
                    Padding="14,8" Margin="0,0,8,0"
                    Background="#3B82F6" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
            <Button Grid.Column="3" Content="{x:Static p:Strings.Dialog_InvalidTos_ForceOpnsenseButton}"
                    Click="OnForceOpnsenseClick"
                    Padding="14,8"
                    Background="#EF4444" Foreground="White" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>
