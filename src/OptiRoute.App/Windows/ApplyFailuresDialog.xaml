<Window x:Class="OptiRoute.App.Windows.ApplyFailuresDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:OptiRoute.App.Markup"
        xmlns:local="clr-namespace:OptiRoute.App.Windows"
        mc:Ignorable="d"
        Title="{loc:LString Key=Card.ApplyFailures.Title}"
        Height="460" Width="520"
        MinHeight="400" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">

    <Window.Resources>
        <local:FailureHeaderConverter x:Key="FailureHeaderConverter"/>

        <Style x:Key="FailureBulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,2,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Foreground" Value="{StaticResource Tokens.Semantic.Error}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Failure list -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="&#x2715;"
                       FontSize="32"
                       Foreground="{StaticResource Tokens.Semantic.Error}"
                       Margin="0,0,14,0"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>
            <StackPanel>
                <TextBlock Text="{loc:LString Key=Card.ApplyFailures.Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Text.Inverse}"/>
                <TextBlock Text="{Binding SummaryText}"
                           FontSize="13"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ══ Failure list ═════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource Styles.Card}"
                Padding="0"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="16">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock Text="{loc:LString Key=Card.ApplyFailures.EmptyState}"
                               Foreground="{StaticResource Tokens.Text.Dim}"
                               FontStyle="Italic"
                               FontSize="13"
                               Visibility="{Binding HasNoFailures, Converter={StaticResource BoolToVis}}"/>

                    <ItemsControl ItemsSource="{Binding Failures}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="&#x2022;"
                                               Style="{StaticResource FailureBulletStyle}"/>

                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding Converter={StaticResource FailureHeaderConverter}}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="{StaticResource Tokens.Text.Primary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Reason}"
                                                   FontSize="12"
                                                   Foreground="{StaticResource Tokens.Semantic.Error}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,0"
                                                   Opacity="0.85"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Footer ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    x:Name="CopyDetailsButton"
                    Content="{loc:LString Key=Card.ApplyFailures.CopyDetailsButton}"
                    Style="{StaticResource Styles.SecondaryButton}"
                    Click="OnCopyDetailsClick"
                    MinWidth="100"
                    Margin="0,0,10,0">
                <Button.ToolTip>
                    <ToolTip Content="Copies failures as a tabular list (Executable | Type | Reason) suitable for pasting into a spreadsheet or support ticket."/>
                </Button.ToolTip>
            </Button>

            <Button Grid.Column="1"
                    Content="{loc:LString Key=Card.ApplyFailures.OpenLogButton}"
                    Style="{StaticResource Styles.SecondaryButton}"
                    Click="OnOpenLogFolderClick"
                    MinWidth="100"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="3"
                    x:Name="CloseButton"
                    Content="{loc:LString Key=Card.ApplyFailures.CloseButton}"
                    Style="{StaticResource Styles.PrimaryButton}"
                    Click="OnCloseClick"
                    MinWidth="90"/>
        </Grid>
    </Grid>
</Window>
