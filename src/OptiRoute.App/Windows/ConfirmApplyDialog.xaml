<Window x:Class="OptiRoute.App.Windows.ConfirmApplyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:OptiRoute.App.Markup"
        mc:Ignorable="d"
        Title="{loc:LString Key=Card.ConfirmApply.Title}"
        Height="420" Width="480"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">

    <Window.Resources>
        <Style x:Key="ConfirmApplyActionBulletStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Action list -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ═══════════════════════════════════════════════════════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="&#x26A0;"
                       FontSize="28"
                       Foreground="{StaticResource Tokens.Semantic.Warning}"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock Text="{loc:LString Key=Card.ConfirmApply.Title}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Text.Inverse}"/>
                <TextBlock Text="{loc:LString Key=Card.ConfirmApply.Subtitle}"
                           FontSize="13"
                           Foreground="{StaticResource Tokens.Text.Dim}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ══ Action list ══════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Style="{StaticResource Styles.Card}"
                Padding="0"
                Margin="0,0,0,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Padding="16">
                <StackPanel>
                    <!-- Empty state -->
                    <TextBlock Text="{loc:LString Key=Card.ConfirmApply.NoActions}"
                               Foreground="{StaticResource Tokens.Text.Dim}"
                               FontStyle="Italic"
                               FontSize="13"
                               Visibility="{Binding HasNoActions, Converter={StaticResource BoolToVis}}"/>

                    <!-- QoS section -->
                    <Border BorderBrush="{StaticResource Tokens.Divider.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasQosActions, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:LString Key=Card.ConfirmApply.QosHeader}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource Tokens.Text.Primary}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding QosActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="&#x2022;"
                                                       Style="{StaticResource ConfirmApplyActionBulletStyle}"
                                                       Foreground="{StaticResource Tokens.Accent.500}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource Tokens.Text.Secondary}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Firewall section -->
                    <Border BorderBrush="{StaticResource Tokens.Divider.Subtle}"
                            BorderThickness="0,0,0,1"
                            Padding="0,8"
                            Visibility="{Binding HasFirewallActions, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{loc:LString Key=Card.ConfirmApply.FirewallHeader}"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       Foreground="{StaticResource Tokens.Text.Primary}"
                                       Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding FirewallActions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <TextBlock Text="&#x2022;"
                                                       Style="{StaticResource ConfirmApplyActionBulletStyle}"
                                                       Foreground="{StaticResource Tokens.Semantic.Warning}"/>
                                            <TextBlock Text="{Binding Description}"
                                                       Foreground="{StaticResource Tokens.Text.Secondary}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Footer ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding SummaryText}"
                       Foreground="{StaticResource Tokens.Text.Dim}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>

            <Button x:Name="CancelButton"
                    Grid.Column="1"
                    Content="{loc:LString Key=Card.ConfirmApply.CancelButton}"
                    Style="{StaticResource Styles.SecondaryButton}"
                    Click="OnCancelClick"
                    MinWidth="90"
                    Margin="0,0,10,0"/>

            <Button Grid.Column="2"
                    Content="{loc:LString Key=Card.ConfirmApply.ApplyButton}"
                    Style="{StaticResource Styles.PrimaryButton}"
                    Click="OnApplyClick"
                    MinWidth="90"/>
        </Grid>
    </Grid>
</Window>
