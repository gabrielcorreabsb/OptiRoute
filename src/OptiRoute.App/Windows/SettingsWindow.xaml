<Window x:Class="OptiRoute.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:OptiRoute.App.Properties"
        xmlns:patterns="clr-namespace:OptiRoute.App.Themes.Patterns"
        Title="{x:Static p:Strings.Settings_WindowTitle}"
        Height="640" Width="780"
        MinHeight="540" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Tokens.Surface.Window}"
        Foreground="{StaticResource Tokens.Text.Primary}"
        ShowInTaskbar="False"
        ResizeMode="CanResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════════════
             Welcome panel (visível somente quando IsFirstRun=true)
             ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource Tokens.Accent.900}"
                BorderBrush="{StaticResource Tokens.Semantic.Info}"
                BorderThickness="2"
                CornerRadius="{StaticResource Tokens.Radius.XLarge}"
                Padding="40"
                Margin="0,0,0,16"
                Visibility="{Binding IsFirstRun, Converter={StaticResource BoolToVis}}">
            <StackPanel MaxWidth="560"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="👋 FIRST TIME SETUP"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Semantic.Warning}"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="{x:Static p:Strings.Wizard_Welcome_Title}"
                           FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource Tokens.Text.Inverse}"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="{x:Static p:Strings.Wizard_Welcome_Subtitle}"
                           FontSize="14"
                           Foreground="{StaticResource Tokens.Text.Secondary}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,24"/>
                <Button Style="{StaticResource Styles.PrimaryButton}"
                        Content="{x:Static p:Strings.Wizard_NextButton}"
                        Click="OnWizardNextClick"
                        HorizontalAlignment="Center"
                        MinWidth="180" Padding="24,12"
                        FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════
             Tabbed settings (Connection / Credentials / Gateways / Advanced)
             ════════════════════════════════════════════════════════════════ -->
        <TabControl x:Name="SettingsTabs"
                    Grid.Row="0"
                    Style="{StaticResource Styles.TabControl}"
                    Visibility="{Binding IsNotFirstRun, Converter={StaticResource BoolToVis}}"
                    ItemContainerStyle="{StaticResource Styles.TabItem}">

            <!-- ─────────── Connection tab ─────────── -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Connection}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How to find your OPNsense address">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="1. Open your OPNsense web interface in a browser."/><LineBreak/>
                                <Run Text="2. The address shown in the address bar is your OPNsense host (e.g. https://192.168.1.1)."/><LineBreak/>
                                <Run Text="3. Typical addresses: https://10.0.0.1, https://192.168.1.1, https://opnsense.local"/><LineBreak/>
                                <Run Text="4. Click 'Detect Again' to auto-fill your local IPv4."/><LineBreak/>
                                <Run Text="5. Connection auto-tests 500ms after you stop typing in Host/Key/ApiSecret."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <TextBlock Text="{x:Static p:Strings.Settings_Connection_OpnsenseAddress}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                 Text="{Binding OpnsenseHost, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static p:Strings.Settings_Connection_LocalComputer}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DetectedIp}"
                                   Foreground="{StaticResource Tokens.Semantic.Success}"
                                   FontSize="12" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static p:Strings.Settings_Connection_PreferredIp}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding PreferredLocalIp, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180"/>
                            <Button Style="{StaticResource Styles.SecondaryButton}"
                                    Content="{x:Static p:Strings.Settings_Connection_DetectIpButton}"
                                    Command="{Binding DetectIpCommand}"
                                    Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ─────────── Credentials tab ─────────── -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Credentials}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How to obtain API credentials">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="1. In OPNsense, navigate to: System → Access → Users."/><LineBreak/>
                                <Run Text="2. Edit your API user (or create a dedicated one)."/><LineBreak/>
                                <Run Text="3. Click 'API keys' tab → '+ Generate new key'."/><LineBreak/>
                                <Run Text="4. Required permissions:"/><LineBreak/>
                                <Run Text="     • Firewall Aliases (read/write)"/><LineBreak/>
                                <Run Text="     • Firewall Rules (read/write)"/><LineBreak/>
                                <Run Text="     • Firewall Category (read/write)"/><LineBreak/>
                                <Run Text="5. Click 'Save' — copy both Key and Secret (shown only once)."/><LineBreak/>
                                <Run Text="6. Paste below, or use 'Import from file' to load the .txt file."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <TextBlock Text="{x:Static p:Strings.Settings_Credentials_ApiKey}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{x:Static p:Strings.Settings_Credentials_ApiSecret}"
                                   Foreground="{StaticResource Tokens.Text.Dim}"
                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <PasswordBox x:Name="SecretBox"
                                         Style="{StaticResource Styles.ModernPasswordBox}"
                                         Width="320"
                                         PasswordChanged="SecretBox_PasswordChanged"/>
                            <Button Style="{StaticResource Styles.SecondaryButton}"
                                    Content="{x:Static p:Strings.Settings_Credentials_RevealSecret}"
                                    Click="OnToggleSecretClick"
                                    Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button Style="{StaticResource Styles.PrimaryButton}"
                                Content="{x:Static p:Strings.Settings_Credentials_ImportFile}"
                                Click="OnImportKeyFileClick"/>
                        <TextBlock Text="{Binding ImportStatus}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <TextBlock Grid.Row="4" Margin="0,16,0,0">
                        <Hyperlink NavigateUri="https://docs.opnsense.org/development/api.html"
                                   RequestNavigate="OnHowToCreateClick"
                                   Foreground="{StaticResource Tokens.Accent.300}">
                            <TextBlock Text="{x:Static p:Strings.Settings_Credentials_HowToCreate}"/>
                        </Hyperlink>
                    </TextBlock>
                </Grid>
            </TabItem>

            <!-- ─────────── Gateways tab ─────────── -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Gateways}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <patterns:InstructionsExpander Grid.Row="0"
                                                   HeaderText="How gateways are configured">
                        <patterns:InstructionsExpander.Slot>
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource Tokens.Text.Secondary}">
                                <Run Text="• Gateway list is pulled from OPNsense (Routing → Gateways)."/><LineBreak/>
                                <Run Text="• Display Name is how OptiRoute refers to each gateway in the UI."/><LineBreak/>
                                <Run Text="• Names must be unique (case-insensitive)."/><LineBreak/>
                                <Run Text="• Click 'Reset' to revert to the original OPNsense name."/>
                            </TextBlock>
                        </patterns:InstructionsExpander.Slot>
                    </patterns:InstructionsExpander>

                    <DataGrid x:Name="GatewaysGrid"
                              Grid.Row="1"
                              Margin="0,16,0,0"
                              Style="{StaticResource Styles.DataGrid}"
                              ItemsSource="{Binding Gateways}"
                              AutoGenerateColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{x:Static p:Strings.Settings_Gateways_ColumnDisplayName}"
                                                Binding="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                            <DataGridTextColumn Header="{x:Static p:Strings.Settings_Gateways_ColumnOpnsenseName}"
                                                Binding="{Binding OpnsenseName}"
                                                IsReadOnly="True" Width="180"/>
                            <DataGridTextColumn Header="{x:Static p:Strings.Settings_Gateways_ColumnStatus}"
                                                Binding="{Binding Status}"
                                                IsReadOnly="True" Width="100"/>
                            <DataGridTemplateColumn Header="{x:Static p:Strings.Settings_Gateways_ColumnActions}"
                                                    Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Styles.Button.Small}"
                                                Content="{x:Static p:Strings.Settings_Gateways_ResetButton}"
                                                Command="{Binding DataContext.ResetDisplayNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{x:Static p:Strings.Settings_Gateways_ResetButtonToolTip}"
                                                Visibility="{Binding IsCustomized, Converter={StaticResource BoolToVis}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Text="{Binding GatewaysStatus}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource Tokens.Text.Dim}" FontSize="12"/>
                </Grid>
            </TabItem>

            <!-- ─────────── Advanced tab ─────────── -->
            <TabItem Header="{x:Static p:Strings.Settings_Tab_Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <patterns:InstructionsExpander
                                HeaderText="Advanced options — recommended defaults">
                            <patterns:InstructionsExpander.Slot>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource Tokens.Text.Secondary}">
                                    <Run Text="• DSCP pool: range of values to auto-assign when registering new apps."/><LineBreak/>
                                    <Run Text="    Avoid reserved values: 0 (default), 46 (EF), 48–63 (CS/experimental)."/><LineBreak/>
                                    <Run Text="• Log retention: days to keep %APPDATA%\OptiRoute\OptiRoute.log."/><LineBreak/>
                                    <Run Text="• Language: requires restart to take effect."/>
                                </TextBlock>
                            </patterns:InstructionsExpander.Slot>
                        </patterns:InstructionsExpander>

                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{x:Static p:Strings.Settings_Advanced_StartWithWindows}"
                                  IsChecked="{Binding StartWithWindows}"
                                  Margin="0,16,0,8"/>
                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{x:Static p:Strings.Settings_Advanced_MinimizeToTray}"
                                  IsChecked="{Binding MinimizeToTray}"
                                  Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{x:Static p:Strings.Settings_Advanced_ShowTechnical}"
                                  IsChecked="{Binding ShowTechnical}"
                                  Margin="0,0,0,12"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static p:Strings.Settings_Advanced_Language}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Style="{StaticResource Styles.ModernComboBox}"
                                      ItemsSource="{Binding AvailableCultures}"
                                      SelectedItem="{Binding SelectedCulture}"
                                      Width="180">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="(restart required)"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       FontStyle="Italic" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="{x:Static p:Strings.Settings_Advanced_LogRetention}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                     Width="80"/>
                        </StackPanel>

                        <CheckBox x:Name="DscpPoolToggle"
                                  Style="{StaticResource Styles.ModernCheckBox}"
                                  Content="{x:Static p:Strings.Settings_Advanced_DscpPoolToggle}"
                                  IsChecked="{Binding EnableAdvancedDscp}"
                                  Margin="0,8,0,4"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    IsEnabled="{Binding ElementName=DscpPoolToggle, Path=IsChecked}">
                            <TextBlock Text="{x:Static p:Strings.Settings_Advanced_DscpPoolStart}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding DscpPoolStart, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"/>
                            <TextBlock Text="{x:Static p:Strings.Settings_Advanced_DscpPoolEnd}"
                                       Foreground="{StaticResource Tokens.Text.Dim}"
                                       VerticalAlignment="Center" Margin="12,0,8,0"/>
                            <TextBox Style="{StaticResource Styles.ModernTextBox}"
                                     Text="{Binding DscpPoolEnd, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer: status indicator (left) + action buttons (right) -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Auto-test status indicator (cross-tab visibility) -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding TestStatusIcon}"
                           FontSize="14" FontWeight="Bold"
                           Foreground="{Binding TestStatusBrush}"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TestStatusText}"
                           Foreground="{Binding TestStatusBrush}"
                           FontWeight="SemiBold" FontSize="12"
                           VerticalAlignment="Center"
                           ToolTip="{Binding TestStatusTooltip}"/>
            </StackPanel>

            <!-- Action buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Styles.SecondaryButton}"
                        Content="{x:Static p:Strings.Common_Cancel}"
                        Click="OnCancelClick"
                        Margin="0,0,8,0"/>
                <Button Style="{StaticResource Styles.PrimaryButton}"
                        Content="{x:Static p:Strings.Common_Save}"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsNotFirstRun, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>